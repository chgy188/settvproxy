<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="32dp"
    android:paddingEnd="32dp"
    android:paddingTop="40dp"
    android:paddingBottom="24dp"
    android:background="#0e0e0e"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="36sp"
        android:textColor="#ffffff"
        android:layout_marginBottom="28dp" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/status_stopped"
        android:textSize="32sp"
        android:textColor="#aaaaaa" />

    <TextView
        android:id="@+id/tvStatusDetail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/status_detail_none"
        android:textSize="17sp"
        android:textColor="#8ab4f8"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btnToggle"
        android:layout_width="420dp"
        android:layout_height="88dp"
        android:text="@string/enable"
        android:textSize="28sp"
        android:textColor="#ffffff"
        android:textAllCaps="false"
        android:background="@drawable/focus_bg"
        android:focusable="true"
        android:nextFocusDown="@+id/btnSettings" />

    <Button
        android:id="@+id/btnSettings"
        android:layout_width="420dp"
        android:layout_height="68dp"
        android:text="@string/settings"
        android:textSize="22sp"
        android:textColor="#ffffff"
        android:textAllCaps="false"
        android:background="@drawable/focus_bg"
        android:focusable="true"
        android:nextFocusUp="@+id/btnToggle"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/tvMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="26dp"
        android:textSize="18sp"
        android:textColor="#ffcc00"
        android:layout_marginTop="24dp" />

    <TextView
        android:layout_width="860dp"
        android:layout_height="wrap_content"
        android:text="@string/main_hint"
        android:textSize="15sp"
        android:textColor="#888888"
        android:gravity="center"
        android:layout_marginTop="12dp" />

</LinearLayout>
