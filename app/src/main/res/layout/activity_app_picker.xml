<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="32dp"
    android:background="#0e0e0e"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_picker_title"
        android:textSize="32sp"
        android:textColor="#ffffff"
        android:layout_marginBottom="16dp" />

    <!-- 过滤模式切换 + 返回 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/btnFilterMode"
            android:layout_width="400dp"
            android:layout_height="wrap_content"
            android:text="@string/filter_mode_none"
            android:textSize="20sp"
            android:background="@drawable/focus_bg"
            android:focusable="true"
            android:padding="12dp" />

        <Button
            android:id="@+id/btnBack"
            android:layout_width="180dp"
            android:layout_height="wrap_content"
            android:text="@string/back"
            android:textSize="20sp"
            android:background="@drawable/focus_bg"
            android:focusable="true"
            android:padding="12dp"
            android:layout_marginStart="24dp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_picker_hint"
        android:textSize="15sp"
        android:textColor="#888888"
        android:layout_marginBottom="12dp" />

    <!-- 应用列表动态生成 Button，天然支持 D-pad 焦点 -->
    <ScrollView
        android:layout_width="720dp"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/appList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_filter_hint"
        android:textSize="14sp"
        android:textColor="#888888"
        android:layout_marginTop="12dp" />

</LinearLayout>
